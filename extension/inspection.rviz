Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 28; 35; 45
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/Image
      Name: Robot RGB
      Enabled: true
      Topic:
        Value: /camera/image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Odometry
      Name: Robot odometry
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Pitch: 0.9
      Yaw: 0.7
Window Geometry:
  Width: 1280
  Height: 800
  X: 0
  Y: 0
